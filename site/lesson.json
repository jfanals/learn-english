d":"assessment_prompt","language":"pt-BR","voice":"pf_dora","text":"Pergunte se alguém gravou os vocais ontem.","audio":"audio/93ce150f780aba26e613.mp3","duration":2.597,"gap":7,"practice":true},{"id":"s142","chapter":"09 · Recuperar as frases sem ajuda","kind":"confirmation","language":"en-US","voice":"af_bella","text":"Did you record the vocals yesterday?","audio":"audio/e3e88a77597541eaecac.mp3","duration":2.1913,"gap":0.8,"practice":false},{"id":"s143","chapter":"09 · Recuperar as frases sem ajuda","kind":"assessment_prompt","language":"pt-BR","voice":"pf_dora","text":"Diga que não gravou os vocais ontem.","audio":"audio/423f549d6205c0db9676.mp3","duration":2.3475,"gap":8,"practice":true},{"id":"s144","chapter":"09 · Recuperar as frases sem ajuda","kind":"confirmation","language":"en-US","voice":"af_bella","text":"I didn't record the vocals yesterday.","audio":"audio/19e5cb55a535efe10d92.mp3","duration":2.2318,"gap":0.8,"practice":false},{"id":"s145","chapter":"09 · Recuperar as frases sem ajuda","kind":"assessment_prompt","language":"pt-BR","voice":"pf_dora","text":"Pergunte o que alguém vai fazer amanhã.","audio":"audio/af84990015ae2af2bf7f.mp3","duration":2.521,"gap":7,"practice":true},{"id":"s146","chapter":"09 · Recuperar as frases sem ajuda","kind":"confirmation","language":"en-US","voice":"af_bella","text":"What are you going to do tomorrow?","audio":"audio/d2a98f9a04152fe7158b.mp3","duration":1.5671,"gap":0.8,"practice":false},{"id":"s147","chapter":"09 · Recuperar as frases sem ajuda","kind":"assessment_prompt","language":"pt-BR","voice":"pf_dora","text":"Diga que vai terminar a mixagem amanhã.","audio":"audio/2984b180193807771e65.mp3","duration":2.6822,"gap":8,"practice":true},{"id":"s148","chapter":"09 · Recuperar as frases sem ajuda","kind":"confirmation","language":"en-US","voice":"af_bella","text":"I'm going to finish the mix tomorrow.","audio":"audio/08743c180086932fba49.mp3","duration":1.8639,"gap":0.8,"practice":false},{"id":"s149","chapter":"09 · Recuperar as frases sem ajuda","kind":"assessment_prompt","language":"pt-BR","voice":"pf_dora","text":"Diga que vai encontrar um amigo amanhã.","audio":"audio/1db88f3a2fd7d2509e85.mp3","duration":2.4975,"gap":8,"practice":true},{"id":"s150","chapter":"09 · Recuperar as frases sem ajuda","kind":"confirmation","language":"en-US","voice":"af_bella","text":"I'm going to meet a friend tomorrow.","audio":"audio/795d5120a6322d33069f.mp3","duration":1.7848,"gap":0.8,"practice":false},{"id":"s151","chapter":"09 · Recuperar as frases sem ajuda","kind":"assessment_prompt","language":"pt-BR","voice":"pf_dora","text":"Peça para tocar de novo.","audio":"audio/4f9149b3b2a7b0886bef.mp3","duration":1.7976,"gap":5,"practice":true},{"id":"s152","chapter":"09 · Recuperar as frases sem ajuda","kind":"confirmation","language":"en-US","voice":"af_bella","text":"Can you play it again?","audio":"audio/2093319381b8ba12d6ce.mp3","duration":1.2906,"gap":0.8,"practice":false},{"id":"s153","chapter":"10 · Sua resposta pessoal","kind":"free_response_prompt","language":"pt-BR","voice":"pf_dora","text":"Agora fale de verdade sobre você. Diga em inglês em que está trabalhando, uma coisa que fez ontem e um plano para amanhã. Pode usar frases curtas. Você terá trinta segundos. Não haverá uma resposta pronta.","audio":"audio/bd8d0d34f4c316bc254b.mp3","duration":11.753,"gap":30,"practice":true},{"id":"s154","chapter":"10 · Sua resposta pessoal","kind":"instruction","language":"pt-BR","voice":"pf_dora","text":"Se quiser, grave essa resposta para comparar com a próxima tentativa. Não há problema se você precisou parar ou procurar palavras.","audio":"audio/4eeb246e2d172220d5d4.mp3","duration":7.6722,"gap":0.6,"practice":false},{"id":"s155","chapter":"10 · Sua resposta pessoal","kind":"instruction","language":"pt-BR","voice":"pf_dora","text":"Amanhã, antes de ouvir esta aula de novo, tente lembrar três frases: uma sobre agora, uma sobre ontem e uma sobre amanhã. Se a maior parte saiu sem ajuda, podemos aumentar a variedade. Se não, vamos praticar menos frases com mais espaço.","audio":"audio/5e02c558ae1ae5fd3e0c.mp3","duration":13.826,"gap":0.6,"practice":false},{"id":"s156","chapter":"10 · Sua resposta pessoal","kind":"instruction","language":"pt-BR","voice":"pf_dora","text":"Fim do piloto. O objetivo não é falar depressa. É conseguir construir a frase e recuperar as palavras com menos esforço.","audio":"audio/ee233c90f2854cebc61a.mp3","duration":7.3891,"gap":1,"practice":false}],"chapters":[{"title":"01 · Como praticar","index":0},{"title":"02 · Agora: montar a frase","index":12},{"title":"03 · Pedir para ouvir de novo","index":34},{"title":"04 · Ontem: uma ação concluída","index":44},{"title":"05 · Perguntar e negar no passado","index":67},{"title":"06 · Amanhã: um plano","index":86},{"title":"07 · Usar a estrutura fora do estúdio","index":106},{"title":"08 · Conversa guiada, sem tradução da pergunta","index":114},{"title":"09 · Recuperar as frases sem ajuda","index":133},{"title":"10 · Sua resposta pessoal","index":152}]}
